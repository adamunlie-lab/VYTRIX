<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════ Palette ═══════════ -->
    <Color x:Key="BgColor">#0A0A0D</Color>
    <Color x:Key="SidebarColor">#0E0E12</Color>
    <Color x:Key="SurfaceColor">#131318</Color>
    <Color x:Key="Surface2Color">#18181E</Color>
    <Color x:Key="Surface3Color">#1F1F27</Color>
    <Color x:Key="BorderColor">#24242C</Color>
    <Color x:Key="BorderStrongColor">#30303A</Color>
    <Color x:Key="TextColor">#ECECF1</Color>
    <Color x:Key="TextDimColor">#A0A0AC</Color>
    <Color x:Key="TextMutedColor">#686874</Color>
    <Color x:Key="AccentColor">#8B5CF6</Color>
    <Color x:Key="AccentHoverColor">#9D74F8</Color>
    <Color x:Key="Accent2Color">#22D3EE</Color>
    <Color x:Key="GoodColor">#34D399</Color>
    <Color x:Key="WarnColor">#FBBF24</Color>
    <Color x:Key="BadColor">#F87171</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}"/>
    <SolidColorBrush x:Key="GoodSoftBrush" Color="#1A34D399"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#1AFBBF24"/>
    <SolidColorBrush x:Key="BadSoftBrush" Color="#1AF87171"/>
    <!-- Accent brushes are replaced at runtime by ThemeManager (accent customisation). -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#228B5CF6"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}"/>
    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A78BFA" Offset="0"/>
        <GradientStop Color="#8B5CF6" Offset="0.5"/>
        <GradientStop Color="#22D3EE" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="NumberFont">Bahnschrift, Segoe UI</FontFamily>

